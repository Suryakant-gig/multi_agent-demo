# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Central PostgreSQL Database
# Target connection format: postgresql://postgres:YOUR_PASSWORD@localhost:5432/infinitygpt
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/infinitygpt

# Storage Configuration
UPLOAD_DIR=./data/uploads
DB_DIR=./data/dbs
CONVERSATIONS_DIR=./data/conversations
MAX_UPLOAD_SIZE_MB=100
CHUNK_SIZE_ROWS=10000

# AI / LLM Configuration (Optional: system automatically runs high-accuracy deterministic semantic engine if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# Research Agent & Web Search Configuration
# Options for WEB_SEARCH_PROVIDER: tavily | serper | brave | scholarly
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
MAX_WEB_RESULTS=5
MAX_RESEARCH_SOURCES=5
MAX_FETCH_CHARS=50000
FETCH_TIMEOUT_SECONDS=15

# Document & PDF Processing
PDF_CHUNK_SIZE_CHARS=1200
PDF_CHUNK_OVERLAP_CHARS=200

# Retrieval Defaults
DEFAULT_TOP_K=5
MAX_SEARCH_RESULTS=50
